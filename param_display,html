<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SQ-80 Glass Editor Prototype</title>
<style>
  :root {
    /* Developer Dark Theme */
    --bg-dark: #05070a;        /* Darker, almost black */
    --panel-glass: rgba(33, 50, 87, 0.322); /* Translucent Navy */
    --sq80-green: #00d9ff;     /* Mirage Blue */
    --label-color: #81abc5;    
    --glass-border: rgba(0, 217, 255, 0.15); /* Subtle cyan border */
    --glass-highlight: rgba(255, 255, 255, 0.339); /* Inner sheen */
    
    /* Layout Variables (STUDIO Spacing Defaults) */
    --master-max-width: 1000px;
    --grid-gap: 10px;
    --row-height: 30px;
    --param-flex: column;
    --label-font: 10px;
    --val-font: 12px;
    --header-font: 12px;
  }

  body {
    background-color: var(--bg-dark);
    background-image: radial-gradient(circle at 50% 50%, #0d1117 0%, #05070a 100%);
    color: var(--sq80-green);
    font-family: 'Segoe UI', 'Roboto Mono', monospace;
    margin: 0;
    padding: 20px;
    min-height: 100vh;
  }

  .page-display {
    background: var(--panel-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-top: 1px solid var(--glass-highlight);
    padding: 12px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: auto var(--row-height) var(--row-height);
    border-radius: 8px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
  }

  /* Specific 4-column override for 3x3 grid blocks */
  .w-3x3 {
    grid-template-columns: repeat(4, 1fr);
  }
  .w-3x3 .header {
    grid-column: span 4;
  }

  .header {
    grid-column: span 5;
    color: #fff;
    font-weight: 600;
    font-size: var(--header-font);
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .param {
    display: flex;
    flex-direction: var(--param-flex);
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    margin: 2px;
    padding: 0 6px;
    border-radius: 3px;
    border: 1px solid rgba(0,0,0,0.3);
  }

  .spacer { background: transparent !important; border: none !important; }

  .label { color: var(--label-color); font-size: var(--label-font); text-transform: uppercase; }
  .val { 
    font-size: var(--val-font); 
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5); 
    /* Ensure composite values stay horizontal */
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 4px;
    }

  .master-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gap);
    max-width: var(--master-max-width);
    margin: 0 auto;
  }

  .w-3x3 { grid-column: span 4; }
  .w-4x2 { grid-column: span 3; }
  .span-2 { grid-column: span 2; }
  .span-3 { grid-column: span 3; }
  .span-4 { grid-column: span 4; }
  .span-5 { grid-column: span 5; }

  @media (max-width: 900px) { .w-3x3, .w-4x2 { grid-column: span 12; } }
</style>
</head>
